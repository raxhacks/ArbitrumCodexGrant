{
  "name": "codex-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "sync-snippets": "node scripts/sync-snippets.mjs",
    "prebuild": "node scripts/sync-snippets.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
